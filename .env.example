# Copy to .env and fill in. Do NOT commit .env to git.
# In Railway, set these in the project's Variables panel.

# ---------- SECURITY ----------
# Required: long random string used to sign session cookies.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ---------- ADMIN ----------
# Admin login (defaults: admin / wcoffee-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=wcoffee-admin

# ---------- PUBLIC ----------
# Public site URL — used in sitemap.xml, canonical tags, OG meta, JSON-LD.
# IMPORTANT: set the real production URL on Railway (no trailing slash).
# Hozirgi prod: https://wanillacoffee.mirolimov.uz
# Kelajakda: https://wanillacoffee.uz (domen ko'chgach yangilang)
SITE_URL=https://wanillacoffee.mirolimov.uz

# ---------- STORAGE ----------
# Where SQLite + orders.json live.
# On Railway, mount a Volume at /data and set DATA_DIR=/data so data
# persists across deploys. Locally leave it as "." (current directory).
DATA_DIR=.

# ---------- SEO VERIFICATION ----------
# Google Search Console verification token (from https://search.google.com/search-console)
# Faqat tokenni qo'ying (full meta-tag emas). Bo'sh qoldirsangiz meta-tag chiqmaydi.
GOOGLE_SITE_VERIFICATION=

# Yandex Webmaster verification token (from https://webmaster.yandex.com)
YANDEX_VERIFICATION=

# ---------- RUNTIME ----------
# Force production mode (forces secure cookies + HSTS header).
# Railway auto-sets RAILWAY_ENVIRONMENT, so this is optional.
# FLASK_ENV=production

# ---------- PORT ----------
# Auto-set by Railway; do not define manually.
# PORT=5050
